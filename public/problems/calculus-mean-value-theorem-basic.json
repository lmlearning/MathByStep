{
  "id": "calculus-mean-value-theorem-basic",
  "type": "problem",
  "title": "Apply Mean Value Theorem",
  "topic": "Calculus",
  "difficulty": 3,
  "estimatedTime": 10,
  "tags": [
    "calculus",
