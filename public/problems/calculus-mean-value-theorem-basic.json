    "derivatives"
  ],
  "statement": {
    "text": "For $f(x) = x^2$ on $[1, 3]$, find the value of $c$ guaranteed by MVT where $f'(c) = \\frac{f(3) - f(1)}{3 - 1}$."
  },
  "objectives": [
    "Calculate average rate of change",
    "Find point where instantaneous = average rate"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Calculate average rate of change: $\\frac{f(3) - f(1)}{3 - 1}$",
        "hint": "$f(3) = 9$, $f(1) = 1$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\frac{9 - 1}{2} = 4$"
        },
        {
          "id": "b",
          "text": "$\\frac{9 - 1}{3} = \\frac{8}{3}$"
        },
        {
          "id": "c",
          "text": "$9 - 1 = 8$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Average rate = $\\frac{8}{2} = 4$",
          "insight": "This is the slope of the secant line from $(1,1)$ to $(3,9)$"
        },
        "incorrect": {
          "1": "Denominator is $3 - 1 = 2$, not 3",
          "2": "Don't forget to divide by the change in $x$"
        }
      },
      "resultState": {
        "description": "Found average rate"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Find $f'(x)$ and set equal to 4",
        "hint": "$f'(x) = 2x$, so $2x = 4$"
      },
      "options": [
        {
          "id": "a",
          "text": "$x = 2$"
        },
        {
          "id": "b",
          "text": "$x = 4$"
        },
        {
          "id": "c",
          "text": "$x = 1$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $2x = 4 \\Rightarrow x = 2$",
          "insight": "$f'(x) = 2x$ is the derivative (power rule)"
        },
        "incorrect": {
          "1": "Solve $2x = 4$: divide both sides by 2",
          "2": "$2(1) = 2 \\neq 4$"
        }
      },
      "resultState": {
        "description": "Set up equation"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Verify $c = 2$ is in $(1, 3)$ and satisfies MVT",
        "hint": "$1 < 2 < 3$ ✓ and $f'(2) = 4$ = average rate ✓"
      },
      "options": [
        {
          "id": "a",
          "text": "$c = 2$"
        },
        {
          "id": "b",
          "text": "$c = 1.5$"
        },
        {
          "id": "c",
          "text": "$c = 3$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! MVT guarantees $c = 2$ where tangent slope = secant slope",
          "insight": "Geometrically: there's a point where tangent line is parallel to secant line"
        },
        "incorrect": {
          "1": "$f'(1.5) = 3 \\neq 4$",
          "2": "$c$ must be in the open interval $(1,3)$, and $c = 3$ is an endpoint"
        }
      },
      "resultState": {
        "description": "Found c value"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "$c = 2$. MVT: there exists a point where instantaneous rate equals average rate."
    ],
    "fullSolution": "Average rate = $\\frac{9-1}{2} = 4$. $f'(x) = 2x = 4 \\Rightarrow c = 2 \\in (1,3)$",
