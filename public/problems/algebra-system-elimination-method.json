      "id": "step-1",
      "order": 1,
      "currentState": {
        "description": "Observe that $y$ coefficients are opposites."
      },
      "prompt": {
        "question": "What do you notice about the $y$ terms?",
        "hint": "One equation has $+2y$, the other has $-2y$. They'll cancel when added!"
      },
      "options": [
        {
          "id": "a",
          "text": "The $y$ coefficients are opposites ($2$ and $-2$), perfect for elimination"
        },
        {
          "id": "b",
          "text": "Need to multiply equations first"
        },
        {
          "id": "c",
          "text": "Use substitution instead"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! When coefficients are opposites, we can add equations to eliminate that variable immediately.",
          "insight": "Elimination is especially efficient when coefficients are already opposites or equal."
        },
        "incorrect": {
          "1": "Look at the coefficients of $y$: $+2$ and $-2$. These are ready to cancel!",
