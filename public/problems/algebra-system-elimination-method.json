    {
      "id": "step-2",
      "order": 2,
      "currentState": {
        "description": "Add the two equations."
      },
      "prompt": {
        "question": "What happens when you add the equations?",
        "hint": "$(3x + 2y) + (5x - 2y) = 16 + 8$"
      },
      "options": [
        {
          "id": "a",
          "text": "$8x = 24$, so $x = 3$"
        },
        {
          "id": "b",
          "text": "$8x + 4y = 24$"
        },
        {
          "id": "c",
          "text": "$2x = 8$, so $x = 4$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Perfect! $3x + 5x = 8x$ and $2y - 2y = 0$. The $y$ terms cancel: $8x = 24$, so $x = 3$.",
          "insight": "Elimination removes one variable, leaving a simple equation in one variable."
