      "id": "step-1",
      "order": 1,
      "currentState": {
        "expression": "Revolve $y=\\sqrt{x}$ around $x$-axis",
        "description": "Disk method: $V = \\pi\\int_a^b [R(x)]^2 dx$ where $R(x)$ is radius."
      },
      "prompt": {
        "question": "What is $R(x)$?",
        "hint": "Distance from $x$-axis to curve: $R(x) = \\sqrt{x}$."
      },
      "options": [
        {
          "id": "a",
          "text": "$V = \\pi\\int_0^4 (\\sqrt{x})^2 dx = \\pi\\int_0^4 x\\, dx$"
        },
        {
          "id": "b",
          "text": "$V = \\pi\\int_0^4 \\sqrt{x}\\, dx$"
        },
