  "statement": {
    "text": "How many ways can you choose 3 people from a group of 7 for a committee?"
  },
  "objectives": [
    "Apply combination formula",
    "Calculate binomial coefficient"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Use combination formula: $\\binom{n}{k} = \\frac{n!}{k!(n-k)!}$",
        "hint": "Here $n = 7$, $k = 3$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\binom{7}{3} = \\frac{7!}{3!4!}$"
        },
        {
          "id": "b",
          "text": "$\\binom{7}{3} = \\frac{7!}{3!}$"
        },
        {
          "id": "c",
          "text": "$\\binom{7}{3} = 7 \\times 3$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Order doesn't matter for committees, so use combinations",
          "insight": "Combinations: order doesn't matter. Permutations: order matters"
        },
        "incorrect": {
          "1": "Don't forget $(n-k)!$ in denominator: $(7-3)! = 4!$",
          "2": "This isn't a simple multiplication problem"
        }
      },
      "resultState": {
        "description": "Set up combination"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
