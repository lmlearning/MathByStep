      },
      "prompt": {
        "question": "Calculate: $\\frac{7!}{3!4!} = \\frac{7 \\times 6 \\times 5}{3 \\times 2 \\times 1}$",
        "hint": "Simplify: $\\frac{210}{6} = 35$"
      },
      "options": [
        {
