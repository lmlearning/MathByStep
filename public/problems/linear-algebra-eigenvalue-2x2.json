{
  "id": "linear-algebra-eigenvalue-2x2",
  "type": "problem",
  "title": "Find Eigenvalues (2×2 Matrix)",
  "topic": "Linear Algebra",
  "difficulty": 4,
  "estimatedTime": 12,
  "tags": [
    "linear-algebra",
    "eigenvalues",
    "characteristic-equation"
  ],
  "statement": {
    "text": "Find the eigenvalues of $A = \\begin{bmatrix} 3 & 1 \\\\ 1 & 3 \\end{bmatrix}$."
  },
  "objectives": [
    "Set up characteristic equation",
    "Solve for eigenvalues"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Characteristic equation: $\\det(A - \\lambda I) = 0$",
        "hint": "$A - \\lambda I = \\begin{bmatrix} 3-\\lambda & 1 \\\\ 1 & 3-\\lambda \\end{bmatrix}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\det\\begin{bmatrix} 3-\\lambda & 1 \\\\ 1 & 3-\\lambda \\end{bmatrix} = 0$"
        },
        {
          "id": "b",
          "text": "$\\det\\begin{bmatrix} 3 & 1 \\\\ 1 & 3 \\end{bmatrix} - \\lambda = 0$"
        },
        {
          "id": "c",
          "text": "$\\begin{bmatrix} 3-\\lambda & 1 \\\\ 1 & 3-\\lambda \\end{bmatrix} = 0$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Subtract $\\lambda$ from diagonal entries",
          "insight": "Eigenvalues are roots of the characteristic equation"
        },
        "incorrect": {
          "1": "Need to subtract $\\lambda I$ from $A$ first",
          "2": "Take determinant of the matrix, not the matrix itself"
        }
      },
      "resultState": {
        "description": "Set up equation"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Calculate determinant: $(3-\\lambda)^2 - (1)(1) = 0$",
        "hint": "Expand: $9 - 6\\lambda + \\lambda^2 - 1 = 0$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\lambda^2 - 6\\lambda + 8 = 0$"
        },
        {
          "id": "b",
          "text": "$\\lambda^2 - 6\\lambda + 9 = 0$"
        },
        {
          "id": "c",
          "text": "$\\lambda^2 + 6\\lambda + 8 = 0$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $(3-\\lambda)^2 - 1 = 9 - 6\\lambda + \\lambda^2 - 1 = \\lambda^2 - 6\\lambda + 8$",
          "insight": "This is a quadratic in $\\lambda$"
        },
        "incorrect": {
          "1": "$(3-\\lambda)^2 = 9 - 6\\lambda + \\lambda^2$, and subtract 1",
          "2": "Check signs: coefficient of $\\lambda$ is $-6$, not $+6$"
        }
      },
      "resultState": {
        "description": "Found characteristic polynomial"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Factor: $\\lambda^2 - 6\\lambda + 8 = (\\lambda - 4)(\\lambda - 2) = 0$",
        "hint": "Eigenvalues: $\\lambda = 4$ and $\\lambda = 2$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\lambda_1 = 4$, $\\lambda_2 = 2$"
        },
        {
          "id": "b",
          "text": "$\\lambda_1 = 3$, $\\lambda_2 = 2$"
        },
        {
          "id": "c",
          "text": "$\\lambda_1 = 6$, $\\lambda_2 = 8$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Eigenvalues are 4 and 2",
          "insight": "Notice: $\\lambda_1 + \\lambda_2 = 6 = \\text{tr}(A)$ and $\\lambda_1\\lambda_2 = 8 = \\det(A)$"
        },
        "incorrect": {
          "1": "Check: 3 and 2 would give $(\\lambda-3)(\\lambda-2) = \\lambda^2 - 5\\lambda + 6$",
          "2": "Those are the coefficients, not the roots"
        }
      },
      "resultState": {
        "description": "Found eigenvalues"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "Eigenvalues: $\\lambda_1 = 4$, $\\lambda_2 = 2$. They sum to trace(A) and multiply to det(A)."
    ],
    "fullSolution": "$\\det(A - \\lambda I) = (3-\\lambda)^2 - 1 = \\lambda^2 - 6\\lambda + 8 = (\\lambda-4)(\\lambda-2) = 0$. So $\\lambda = 4, 2$",
