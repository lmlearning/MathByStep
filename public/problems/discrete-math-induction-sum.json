  "statement": {
    "text": "Prove by induction: $1 + 2 + 3 + \\cdots + n = \\frac{n(n+1)}{2}$ for all $n \\geq 1$."
  },
  "objectives": [
    "Apply induction method",
    "Prove base case and inductive step"
  ],
  "steps": [
