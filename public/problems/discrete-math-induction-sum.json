        "description": "Step 1"
      },
      "prompt": {
        "question": "Base case: verify formula for $n = 1$",
        "hint": "LHS: $1$. RHS: $\\frac{1(2)}{2} = 1$. Equal ✓"
      },
      "options": [
        {
          "id": "a",
          "text": "Base case holds: both sides equal 1"
        },
        {
          "id": "b",
          "text": "Base case fails"
