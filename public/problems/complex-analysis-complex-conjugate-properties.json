  "statement": {
    "text": "Let $z = 3 + 4i$. Find $\\bar{z}$, $z + \\bar{z}$, $z \\cdot \\bar{z}$, and $|z|$."
  },
  "objectives": [
    "Find complex conjugate",
    "Apply conjugate properties",
    "Calculate magnitude"
