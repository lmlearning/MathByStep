  "steps": [
    {
      "id": "step-1",
      "order": 1,
      "currentState": {
        "description": "Find the complex conjugate."
      },
      "prompt": {
        "question": "What is $\\bar{z}$?",
        "hint": "Complex conjugate: change sign of imaginary part. $\\bar{3+4i} = 3-4i$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\bar{z} = 3 - 4i$"
        },
        {
          "id": "b",
          "text": "$\\bar{z} = -3 + 4i$"
        },
        {
          "id": "c",
          "text": "$\\bar{z} = -3 - 4i$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Complex conjugate: flip the sign of the imaginary part. $\\overline{a+bi} = a-bi$. So $\\overline{3+4i} = 3-4i$.",
          "insight": "Geometrically, conjugate reflects the complex number across the real axis."
        },
        "incorrect": {
          "1": "Only change the sign of the imaginary part, not the real part! $\\overline{3+4i} = 3-4i$.",
          "2": "Conjugate means changing sign of imaginary part only: $3+4i \\to 3-4i$."
        }
      },
      "resultState": {
        "description": "Found conjugate"
      }
