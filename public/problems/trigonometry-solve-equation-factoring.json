  "statement": {
    "text": "Solve for $\\theta$ in $[0, 2\\pi)$: $2\\sin^2\\theta = \\sin\\theta$."
  },
  "objectives": [
    "Rearrange to standard form",
    "Factor and solve"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Move all terms to one side",
        "hint": "$2\\sin^2\\theta - \\sin\\theta = 0$"
      },
      "options": [
        {
          "id": "a",
          "text": "$2\\sin^2\\theta - \\sin\\theta = 0$"
        },
        {
          "id": "b",
          "text": "$2\\sin^2\\theta = \\sin\\theta$ (already in standard form)"
        },
        {
          "id": "c",
          "text": "$\\sin^2\\theta - \\sin\\theta = 2$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Subtract $\\sin\\theta$ from both sides",
          "insight": "Always rearrange to get 0 on one side before factoring"
        },
        "incorrect": {
          "1": "Need one side to equal zero to factor effectively",
          "2": "Subtract $\\sin\\theta$ from both sides, don't divide"
        }
      },
      "resultState": {
        "description": "Standard form"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Factor out $\\sin\\theta$",
        "hint": "$\\sin\\theta(2\\sin\\theta - 1) = 0$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\sin\\theta(2\\sin\\theta - 1) = 0$"
        },
        {
          "id": "b",
          "text": "$(2\\sin\\theta - 1)(\\sin\\theta + 1) = 0$"
        },
        {
          "id": "c",
          "text": "$2\\sin\\theta(\\sin\\theta - 1) = 0$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Factor out common $\\sin\\theta$",
          "insight": "Now use zero product property: each factor can equal zero"
        },
        "incorrect": {
          "1": "This doesn't give the original when expanded",
          "2": "Close, but $\\sin\\theta$ is the GCF, not $2\\sin\\theta$"
        }
      },
      "resultState": {
        "description": "Factored equation"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Solve each factor: $\\sin\\theta = 0$ or $2\\sin\\theta - 1 = 0$",
        "hint": "$\\theta = 0, \\pi$ or $\\sin\\theta = \\frac{1}{2}$ gives $\\theta = \\frac{\\pi}{6}, \\frac{5\\pi}{6}$"
      },
      "options": [
        {
          "id": "a",
