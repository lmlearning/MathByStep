      "prompt": {
        "question": "Find GCF of coefficients (6, 9, 12) and powers of $x$",
        "hint": "GCF of 6, 9, 12 is 3. Lowest power of $x$ is $x^1$"
      },
      "options": [
        {
          "id": "a",
          "text": "GCF = $3x$"
        },
        {
          "id": "b",
          "text": "GCF = $3$"
        },
        {
          "id": "c",
          "text": "GCF = $6x$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! GCF is $3x$ (divides all terms evenly)",
          "insight": "GCF includes both numerical and variable factors"
        },
        "incorrect": {
          "1": "Don't forget the variable factor: all terms have at least $x$",
          "2": "6 doesn't divide 9, so GCF of coefficients is 3"
