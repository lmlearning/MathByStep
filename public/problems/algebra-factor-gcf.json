        "description": "Step 2"
      },
      "prompt": {
        "question": "Factor out $3x$: divide each term by $3x$",
        "hint": "$\\frac{6x^3}{3x} = 2x^2$, $\\frac{9x^2}{3x} = 3x$, $\\frac{-12x}{3x} = -4$"
      },
      "options": [
        {
          "id": "a",
          "text": "$3x(2x^2 + 3x - 4)$"
        },
        {
