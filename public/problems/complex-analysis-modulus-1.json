      "id": "step-1",
      "order": 1,
      "currentState": {
        "description": "Recall formula"
      },
      "prompt": {
        "question": "$|a + bi| = ?$",
        "hint": "$\\sqrt{a^2 + b^2}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\sqrt{a^2 + b^2}$"
        },
        {
          "id": "b",
          "text": "$a + b$"
        },
        {
          "id": "c",
          "text": "$\\sqrt{a + b}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Modulus: $|a+bi| = \\sqrt{a^2+b^2}$",
          "insight": "Pythagorean theorem"
        },
        "incorrect": {
          "1": "Use square root of sum of squares",
          "2": "Square each part first"
        }
      },
      "resultState": {
        "description": "$|3+4i| = \\sqrt{3^2+4^2}$"
      }
    },
    {
      "id": "step-2",
      "order": 2,
      "currentState": {
        "description": "Calculate"
      },
      "prompt": {
        "question": "$\\sqrt{9 + 16} = ?$",
        "hint": "$\\sqrt{25} = 5$"
      },
      "options": [
        {
          "id": "a",
          "text": "$5$"
        },
        {
          "id": "b",
          "text": "$7$"
        },
        {
          "id": "c",
          "text": "$25$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "$\\sqrt{25} = 5$",
          "insight": "3-4-5 right triangle!"
        },
        "incorrect": {
          "1": "That's $9+16$, not the square root",
          "2": "Don't forget the square root"
        }
      },
      "resultState": {
        "description": "$|3+4i| = 5$"
      }
    }
  ],
  "summary": {
    "keyInsights": [
