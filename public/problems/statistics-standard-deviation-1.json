      "prompt": {
        "question": "Variance $s^2 = \\frac{\\sum(x_i - \\bar{x})^2}{n-1}$",
        "hint": "Deviations squared: $(4-6)^2=4, (8-6)^2=4, (6-6)^2=0, (5-6)^2=1, (7-6)^2=1$"
      },
      "options": [
        {
          "id": "a",
          "text": "Sum = $4+4+0+1+1=10$"
