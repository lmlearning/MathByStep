  "statement": {
    "text": "Roll two fair dice. What's the probability both show 6?"
  },
  "objectives": [
    "Identify independent events",
    "Multiply probabilities"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Are the two dice rolls independent?",
        "hint": "Result of first die doesn't affect second die"
      },
      "options": [
        {
          "id": "a",
          "text": "Yes, independent events"
        },
        {
          "id": "b",
          "text": "No, dependent events"
        },
        {
          "id": "c",
          "text": "Cannot determine"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Dice rolls are independent",
          "insight": "Independent: outcome of one doesn't affect probability of the other"
        },
        "incorrect": {
          "1": "Each die roll is separate; one doesn't influence the other",
          "2": "Physical independence: dice don't affect each other"
        }
      },
      "resultState": {
        "description": "Identified independence"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "For independent events: $P(A \\text{ and } B) = P(A) \\times P(B)$",
        "hint": "$P(\\text{first 6}) = \\frac{1}{6}$, $P(\\text{second 6}) = \\frac{1}{6}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$P(\\text{both 6}) = \\frac{1}{6} \\times \\frac{1}{6}$"
        },
        {
          "id": "b",
          "text": "$P(\\text{both 6}) = \\frac{1}{6} + \\frac{1}{6}$"
        },
        {
          "id": "c",
          "text": "$P(\\text{both 6}) = \\frac{2}{6}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Multiply probabilities for independent events",
          "insight": "\"AND\" for independent events → multiply probabilities"
        },
        "incorrect": {
          "1": "Use multiplication for \"and\", not addition",
          "2": "This would be for \"or\", not \"and\""
        }
      },
      "resultState": {
        "description": "Set up calculation"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Calculate: $\\frac{1}{6} \\times \\frac{1}{6} = ?$",
        "hint": "$\\frac{1}{36}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\frac{1}{36}$"
        },
        {
          "id": "b",
          "text": "$\\frac{1}{12}$"
        },
        {
          "id": "c",
          "text": "$\\frac{2}{6} = \\frac{1}{3}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $P(\\text{both 6}) = \\frac{1}{36} \\approx 2.78\\%$",
          "insight": "Out of 36 equally likely outcomes, only 1 is (6,6)"
        },
        "incorrect": {
          "1": "$\\frac{1}{6} \\times \\frac{1}{6} = \\frac{1}{36}$",
          "2": "That would be addition, not multiplication"
        }
      },
      "resultState": {
        "description": "Found probability"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "$P(\\text{both 6}) = \\frac{1}{36}$. For independent events: multiply probabilities."
    ],
    "fullSolution": "Dice rolls are independent. $P(\\text{both 6}) = P(\\text{first 6}) \\times P(\\text{second 6}) = \\frac{1}{6} \\times \\frac{1}{6} = \\frac{1}{36}$",
