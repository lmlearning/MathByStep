      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Perfect! Chain rule: $\\frac{d}{dx}\\sin(3x) = \\cos(3x) \\cdot 3 = 3\\cos(3x)$. Power rule: $\\frac{d}{dx}(2x) = 2$.",
          "insight": "Don't forget the chain rule when differentiating $\\sin(3x)$!"
        },
