      },
      "prompt": {
        "question": "Identify outer and inner functions: $f(g(x))$ where $f(u) = \\sin(u)$ and $g(x) = 3x^2$",
        "hint": "Chain rule: $(f \\circ g)'(x) = f'(g(x)) \\cdot g'(x)$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\cos(3x^2) \\cdot \\frac{d}{dx}[3x^2]$"
        },
        {
          "id": "b",
          "text": "$\\cos(3x^2)$"
        },
        {
          "id": "c",
          "text": "$\\sin(6x)$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Derivative of outer times derivative of inner",
          "insight": "Chain rule: differentiate outside, keep inside, multiply by derivative of inside"
        },
        "incorrect": {
          "1": "Don't forget to multiply by derivative of inner function",
          "2": "Can't simplify like this; use chain rule"
        }
      },
      "resultState": {
        "description": "Applied chain rule"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Find $\\frac{d}{dx}[3x^2]$",
        "hint": "$\\frac{d}{dx}[3x^2] = 6x$"
      },
      "options": [
        {
          "id": "a",
          "text": "$6x$"
        },
        {
          "id": "b",
          "text": "$3x$"
        },
        {
          "id": "c",
          "text": "$x^2$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Power rule: $\\frac{d}{dx}[3x^2] = 3 \\cdot 2x = 6x$",
          "insight": "Now multiply: $\\cos(3x^2) \\cdot 6x$"
        },
        "incorrect": {
          "1": "Power rule: bring down exponent and reduce power",
          "2": "Use power rule: $\\frac{d}{dx}[ax^n] = anx^{n-1}$"
        }
      },
      "resultState": {
        "description": "Found derivative of inner function"
      }
