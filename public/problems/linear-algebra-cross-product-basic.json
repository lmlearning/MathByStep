      },
      "prompt": {
        "question": "Set up determinant: $\\vec{u} \\times \\vec{v} = \\begin{vmatrix} \\vec{i} & \\vec{j} & \\vec{k} \\\\ 1 & 0 & 2 \\\\ 0 & 3 & 1 \\end{vmatrix}$",
        "hint": "Expand along first row"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\vec{i}\\begin{vmatrix}0 & 2\\\\3 & 1\\end{vmatrix} - \\vec{j}\\begin{vmatrix}1 & 2\\\\0 & 1\\end{vmatrix} + \\vec{k}\\begin{vmatrix}1 & 0\\\\0 & 3\\end{vmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\langle 1-0, 0-6, 3-0 \\rangle$"
        },
        {
