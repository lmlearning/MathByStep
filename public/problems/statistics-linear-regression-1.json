        }
      ],
      "correctOption": "a",
      "feedback": {
        "correct": {
          "explanation": "Perfect! Deviations from mean: $x_i - \\bar{x}$: -2,-1,0,1,2. $y_i - \\bar{y}$: -2,-1,1,0,2. Products: 4,1,0,0,4. Sum=9. $\\sum(x_i-\\bar{x})^2 = 4+1+0+1+4=10$. Slope: $b=9/10=0.9$.",
          "insight": "Slope represents the change in $y$ per unit change in $x$."
