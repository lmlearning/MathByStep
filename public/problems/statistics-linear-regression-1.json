    {
      "id": "step-2",
      "title": "Calculate slope",
      "currentState": {
        "expression": "$b = \\frac{\\sum(x_i - \\bar{x})(y_i - \\bar{y})}{\\sum(x_i - \\bar{x})^2}$",
        "description": "Compute numerator and denominator."
      },
      "reflectionPrompt": {
        "question": "What is the slope $b$?",
        "hint": "$(x_i - \\bar{x})(y_i - \\bar{y})$: $(-2)(-2)=4, (-1)(-1)=1, (0)(1)=0, (1)(0)=0, (2)(2)=4$. Sum = 9. $(x_i-\\bar{x})^2$: $4,1,0,1,4$. Sum = 10. $b = 9/10 = 0.9$."
      },
      "options": [
