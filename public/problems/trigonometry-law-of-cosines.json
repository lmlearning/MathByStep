  "statement": {
    "text": "A triangle has sides $a = 7$, $b = 9$, and $c = 5$. Find the measure of angle $C$ (the angle opposite side $c$)."
  },
  "objectives": [
    "Apply law of cosines",
    "Solve for angle",
