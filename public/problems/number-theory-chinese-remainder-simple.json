      "resultState": {
        "description": "Found solution"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "General solution: $x = 8 + 15n$ for any integer $n$",
        "hint": "Solutions repeat every $\\text{lcm}(3,5) = 15$"
