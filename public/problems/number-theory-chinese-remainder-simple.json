      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "From first condition: $x = 3k + 2$ for some integer $k$",
        "hint": "Numbers: 2, 5, 8, 11, 14, 17, 20, 23, ..."
      },
      "options": [
        {
          "id": "a",
          "text": "$x = 2, 5, 8, 11, 14, ...$"
        },
        {
          "id": "b",
          "text": "$x = 3, 6, 9, 12, 15, ...$"
        },
        {
          "id": "c",
          "text": "$x = 2, 4, 6, 8, 10, ...$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $x \\equiv 2 \\pmod{3}$ means $x = 3k + 2$",
          "insight": "List values satisfying first condition, then test second"
        },
        "incorrect": {
          "1": "These give remainder 0 mod 3, not 2",
          "2": "These give all even numbers, not necessarily $\\equiv 2 \\pmod{3}$"
        }
      },
      "resultState": {
        "description": "Listed candidates"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Which value also satisfies $x \\equiv 3 \\pmod{5}$?",
        "hint": "Test: $2 \\bmod 5 = 2$, $5 \\bmod 5 = 0$, $8 \\bmod 5 = 3$ ✓"
      },
      "options": [
        {
          "id": "a",
          "text": "$x = 8$"
        },
        {
          "id": "b",
          "text": "$x = 2$"
        },
        {
          "id": "c",
          "text": "$x = 5$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $8 = 3(2) + 2$ and $8 = 5(1) + 3$",
          "insight": "8 is the smallest positive integer satisfying both conditions"
