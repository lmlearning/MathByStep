  "statement": {
    "text": "Find the smallest positive integer $x$ where $x \\equiv 2 \\pmod{3}$ and $x \\equiv 3 \\pmod{5}$."
  },
  "objectives": [
    "Apply Chinese Remainder Theorem",
    "Find solution systematically"
  ],
  "steps": [
