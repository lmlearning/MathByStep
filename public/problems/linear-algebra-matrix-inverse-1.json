      "id": "step-2",
      "order": 2,
      "currentState": {
        "description": "Formula: $A^{-1} = \\frac{1}{\\det(A)} \\begin{bmatrix} d & -b \\\\ -c & a \\end{bmatrix}$."
      },
      "prompt": {
        "question": "What is $A^{-1}$?",
        "hint": "Swap $a$ and $d$, negate $b$ and $c$, then divide by det = 1."
