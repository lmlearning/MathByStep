  "steps": [
    {
      "id": "step-1",
      "order": 1,
      "currentState": {
        "description": "Matrix is invertible if $\\det(A) \\neq 0$."
      },
      "prompt": {
        "question": "What is $\\det(A)$?",
        "hint": "For $\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix}$, det = $ad - bc$."
      },
      "options": [
        {
          "id": "a",
          "text": "$\\det(A) = (3)(2) - (1)(5) = 6 - 5 = 1 \\neq 0$ (invertible!)"
        },
        {
          "id": "b",
          "text": "$\\det(A) = 3 + 2 - 1 - 5 = -1$"
        },
        {
          "id": "c",
          "text": "$\\det(A) = 0$ (not invertible)"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
