  "statement": {
    "text": "Find the inverse of $A = \\begin{bmatrix} 2 & 3 \\\\ 1 & 4 \\end{bmatrix}$."
  },
  "objectives": [
    "Check if matrix is invertible",
    "Apply 2×2 inverse formula"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "First check: is $\\det(A) \\neq 0$?",
        "hint": "$\\det\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix} = ad - bc$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\det(A) = 2(4) - 3(1) = 5 \\neq 0$ (invertible)"
        },
        {
          "id": "b",
          "text": "$\\det(A) = 2(1) - 3(4) = -10$"
        },
        {
          "id": "c",
          "text": "$\\det(A) = 0$ (not invertible)"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! $\\det(A) = 8 - 3 = 5 \\neq 0$, so inverse exists",
          "insight": "Matrix is invertible if and only if determinant is non-zero"
        },
        "incorrect": {
          "1": "Main diagonal products: $ad = 2 \\times 4 = 8$, not $2 \\times 1$",
          "2": "$\\det(A) = 5$, not zero"
        }
      },
      "resultState": {
        "description": "Verified invertibility"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Formula: $\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix}^{-1} = \\frac{1}{ad-bc}\\begin{bmatrix} d & -b \\\\ -c & a \\end{bmatrix}$",
        "hint": "Swap $a$ and $d$, negate $b$ and $c$, divide by det"
      },
      "options": [
        {
          "id": "a",
          "text": "$A^{-1} = \\frac{1}{5}\\begin{bmatrix} 4 & -3 \\\\ -1 & 2 \\end{bmatrix}$"
        },
        {
          "id": "b",
          "text": "$A^{-1} = \\frac{1}{5}\\begin{bmatrix} 2 & -3 \\\\ -1 & 4 \\end{bmatrix}$"
        },
        {
          "id": "c",
          "text": "$A^{-1} = \\begin{bmatrix} 4 & -3 \\\\ -1 & 2 \\end{bmatrix}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Swap diagonals (2↔4), negate off-diagonals, divide by 5",
          "insight": "Remember the pattern: swap diagonal, negate off-diagonal, scale by $\\frac{1}{\\det}$"
        },
        "incorrect": {
          "1": "Need to swap the diagonal elements: 2↔4",
          "2": "Don't forget to divide by determinant (5)"
        }
      },
      "resultState": {
        "description": "Applied formula"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Simplify: $A^{-1} = \\begin{bmatrix} ? & ? \\\\ ? & ? \\end{bmatrix}$",
        "hint": "$\\begin{bmatrix} 4/5 & -3/5 \\\\ -1/5 & 2/5 \\end{bmatrix}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\begin{bmatrix} 0.8 & -0.6 \\\\ -0.2 & 0.4 \\end{bmatrix}$"
        },
        {
          "id": "b",
          "text": "$\\begin{bmatrix} 4/5 & 3/5 \\\\ 1/5 & 2/5 \\end{bmatrix}$"
        },
        {
          "id": "c",
          "text": "$\\begin{bmatrix} 5/4 & 5/3 \\\\ 5/1 & 5/2 \\end{bmatrix}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Verify: $AA^{-1} = I$ ✓",
          "insight": "Check: $\\begin{bmatrix} 2 & 3 \\\\ 1 & 4 \\end{bmatrix}\\begin{bmatrix} 0.8 & -0.6 \\\\ -0.2 & 0.4 \\end{bmatrix} = \\begin{bmatrix} 1 & 0 \\\\ 0 & 1 \\end{bmatrix}$"
        },
        "incorrect": {
          "1": "Keep the negative signs: $-3/5$ and $-1/5$",
          "2": "Multiply matrix by $1/5$, don't divide denominator by matrix entries"
        }
      },
      "resultState": {
        "description": "Found inverse"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "$A^{-1} = \\begin{bmatrix} 4/5 & -3/5 \\\\ -1/5 & 2/5 \\end{bmatrix}$. For 2×2: swap diagonal, negate off-diagonal, divide by det."
    ],
    "fullSolution": "$\\det(A) = 5$. $A^{-1} = \\frac{1}{5}\\begin{bmatrix} 4 & -3 \\\\ -1 & 2 \\end{bmatrix} = \\begin{bmatrix} 4/5 & -3/5 \\\\ -1/5 & 2/5 \\end{bmatrix}$",
