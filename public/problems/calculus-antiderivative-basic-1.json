  "statement": {
    "text": "Find $\\int x^3 dx$"
  },
  "objectives": [
    "Apply power rule for integration"
  ],
  "steps": [
    {
      "id": "step-1",
      "order": 1,
      "currentState": {
        "description": "Recall power rule"
      },
      "prompt": {
        "question": "$\\int x^n dx = ?$",
        "hint": "$\\frac{x^{n+1}}{n+1} + C$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\frac{x^{n+1}}{n+1} + C$"
        },
        {
          "id": "b",
          "text": "$nx^{n-1} + C$"
        },
        {
          "id": "c",
          "text": "$x^{n+1} + C$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Integration power rule: increase exponent by 1, divide by new exponent",
          "insight": "Opposite of differentiation"
        },
        "incorrect": {
          "1": "That's the derivative!",
          "2": "Don't forget to divide"
        }
      },
      "resultState": {
        "description": "$\\int x^n dx = \\frac{x^{n+1}}{n+1} + C$"
      }
    },
    {
      "id": "step-2",
      "order": 2,
      "currentState": {
        "description": "Apply to $x^3$"
      },
      "prompt": {
        "question": "$\\int x^3 dx = ?$",
        "hint": "$\\frac{x^4}{4} + C$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\frac{x^4}{4} + C$"
        },
        {
          "id": "b",
          "text": "$x^4 + C$"
        },
        {
          "id": "c",
          "text": "$3x^2 + C$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "$\\int x^3 dx = \\frac{x^{3+1}}{3+1} + C = \\frac{x^4}{4} + C$",
          "insight": "Check: $\\frac{d}{dx}[\\frac{x^4}{4}] = x^3$ ✓"
        },
        "incorrect": {
          "1": "Divide by $n+1 = 4$",
          "2": "That's the derivative"
        }
      },
      "resultState": {
        "description": "$\\int x^3 dx = \\frac{x^4}{4} + C$"
      }
    }
  ],
  "summary": {
    "keyInsights": [
