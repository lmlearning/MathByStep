  "statement": {
    "text": "Find the area of a sector with radius 8 cm and central angle $\\frac{\\pi}{3}$ radians."
  },
  "objectives": [
    "Apply sector area formula",
    "Use radians correctly"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Sector area formula: $A = \\frac{1}{2}r^2\\theta$ (when $\\theta$ in radians)",
        "hint": "$A = \\frac{1}{2}(8)^2(\\frac{\\pi}{3})$"
      },
      "options": [
        {
          "id": "a",
          "text": "$A = \\frac{1}{2}(64)(\\frac{\\pi}{3})$"
        },
        {
          "id": "b",
          "text": "$A = \\pi(8)^2(\\frac{\\pi}{3})$"
        },
        {
          "id": "c",
          "text": "$A = (8)(\\frac{\\pi}{3})$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Sector area is half of $r^2\\theta$",
          "insight": "Formula only works with radians, not degrees"
        },
        "incorrect": {
          "1": "That's closer to full circle area; sector uses $\\frac{1}{2}r^2\\theta$",
          "2": "Don't forget to square the radius"
        }
      },
      "resultState": {
        "description": "Applied formula"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "Calculate: $\\frac{1}{2} \\cdot 64 \\cdot \\frac{\\pi}{3} = ?$",
        "hint": "$\\frac{64\\pi}{6} = \\frac{32\\pi}{3}$"
      },
      "options": [
        {
          "id": "a",
          "text": "$\\frac{32\\pi}{3}$ cm²"
        },
        {
          "id": "b",
          "text": "$\\frac{64\\pi}{3}$ cm²"
        },
        {
          "id": "c",
          "text": "$\\frac{16\\pi}{3}$ cm²"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Area = $\\frac{32\\pi}{3} \\approx 33.5$ cm²",
          "insight": "Check: angle $\\frac{\\pi}{3}$ is $\\frac{1}{6}$ of full circle, so area = $\\frac{1}{6}(\\pi r^2) = \\frac{64\\pi}{6} = \\frac{32\\pi}{3}$ ✓"
        },
        "incorrect": {
          "1": "Simplify: $\\frac{64}{2 \\cdot 3} = \\frac{64}{6} = \\frac{32}{3}$",
          "2": "Don't forget the $\\frac{1}{2}$ in the formula"
        }
      },
      "resultState": {
        "description": "Found sector area"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "Sector area = $\\frac{32\\pi}{3}$ cm² $\\approx 33.5$ cm². Formula: $A = \\frac{1}{2}r^2\\theta$ (radians)"
    ],
    "fullSolution": "$A = \\frac{1}{2}r^2\\theta = \\frac{1}{2}(8)^2(\\frac{\\pi}{3}) = \\frac{64\\pi}{6} = \\frac{32\\pi}{3}$ cm²",
