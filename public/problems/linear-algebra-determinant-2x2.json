      "prompt": {
        "question": "For $\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix}$, det = $ad - bc$",
        "hint": "Multiply diagonal elements, then subtract"
      },
      "options": [
        {
          "id": "a",
          "text": "det = $(4)(3) - (7)(2)$"
        },
        {
          "id": "b",
          "text": "det = $(4)(2) - (7)(3)$"
        },
        {
          "id": "c",
          "text": "det = $(4)(3) + (7)(2)$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
