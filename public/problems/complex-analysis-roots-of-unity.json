{
  "id": "complex-analysis-roots-of-unity",
  "type": "problem",
  "title": "Find Cube Roots of Unity",
  "topic": "Complex Analysis",
  "difficulty": 3,
  "estimatedTime": 10,
  "tags": [
    "complex-analysis",
    "roots-of-unity",
    "polar-form"
  ],
  "statement": {
    "text": "Find all three cube roots of 1 (solutions to $z^3 = 1$)."
  },
  "objectives": [
    "Use polar form and De Moivre",
    "Find all roots"
  ],
  "steps": [
    {
      "id": "s1",
      "order": 1,
      "currentState": {
        "description": "Step 1"
      },
      "prompt": {
        "question": "Write 1 in polar form: $1 = 1(\\cos 0 + i\\sin 0)$",
        "hint": "But also: $1 = 1(\\cos 2\\pi k + i\\sin 2\\pi k)$ for any integer $k$"
      },
      "options": [
        {
          "id": "a",
          "text": "$1 = e^{i \\cdot 2\\pi k}$ for integer $k$"
        },
        {
          "id": "b",
          "text": "$1 = \\cos 0 + i\\sin 0$ only"
        },
        {
          "id": "c",
          "text": "$1 = 1 + 0i$ (rectangular only)"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Angle 0 and $2\\pi$ represent same point (full rotation)",
          "insight": "This periodicity is key to finding all roots"
        },
        "incorrect": {
          "1": "True, but need periodicity to find all roots",
          "2": "Need polar form to use De Moivre's theorem"
        }
      },
      "resultState": {
        "description": "Wrote in polar form"
      }
    },
    {
      "id": "s2",
      "order": 2,
      "currentState": {
        "description": "Step 2"
      },
      "prompt": {
        "question": "For $z^3 = 1$: $z = 1^{1/3} = e^{i\\cdot 2\\pi k/3}$ for $k = 0, 1, 2$",
        "hint": "Three roots with angles: $0, \\frac{2\\pi}{3}, \\frac{4\\pi}{3}$"
      },
      "options": [
        {
          "id": "a",
          "text": "Angles: $0°, 120°, 240°$ or $0, \\frac{2\\pi}{3}, \\frac{4\\pi}{3}$ radians"
        },
        {
          "id": "b",
          "text": "Just one root: $z = 1$"
        },
        {
          "id": "c",
          "text": "Angles: $0°, 60°, 120°$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! Divide full circle by 3 to get equally spaced roots",
          "insight": "$n$-th roots are evenly spaced around circle"
        },
        "incorrect": {
          "1": "Cubic equation has 3 complex roots",
          "2": "$\\frac{360°}{3} = 120°$ spacing, not 60°"
        }
      },
      "resultState": {
        "description": "Found angles"
      }
    },
    {
      "id": "s3",
      "order": 3,
      "currentState": {
        "description": "Step 3"
      },
      "prompt": {
        "question": "Convert to rectangular form",
        "hint": "$z_0 = 1$, $z_1 = -\\frac{1}{2} + \\frac{\\sqrt{3}}{2}i$, $z_2 = -\\frac{1}{2} - \\frac{\\sqrt{3}}{2}i$"
      },
      "options": [
        {
          "id": "a",
          "text": "$1, -\\frac{1}{2} + \\frac{\\sqrt{3}}{2}i, -\\frac{1}{2} - \\frac{\\sqrt{3}}{2}i$"
        },
        {
          "id": "b",
          "text": "$1, i, -1$"
        },
        {
          "id": "c",
          "text": "$1, \\omega, \\omega^2$ where $\\omega = e^{i\\pi/3}$"
        }
      ],
      "correctOptionIndex": 0,
      "feedback": {
        "correct": {
          "explanation": "Correct! These are the three cube roots of unity",
          "insight": "Often written as $1, \\omega, \\omega^2$ where $\\omega = e^{2\\pi i/3} = -\\frac{1}{2} + \\frac{\\sqrt{3}}{2}i$"
        },
        "incorrect": {
          "1": "Those are fourth roots of unity (solutions to $z^4 = 1$)",
          "2": "Close notation, but $\\omega = e^{2\\pi i/3}$, not $e^{\\pi i/3}$"
        }
      },
      "resultState": {
        "description": "Found all roots"
      }
    }
  ],
  "summary": {
    "keyInsights": [
      "Cube roots of unity: $1, -\\frac{1}{2} \\pm \\frac{\\sqrt{3}}{2}i$. They form equilateral triangle on unit circle."
    ],
    "fullSolution": "$z^3 = 1 = e^{2\\pi ik}$, so $z = e^{2\\pi ik/3}$ for $k=0,1,2$. Roots: $1, e^{2\\pi i/3}, e^{4\\pi i/3}$ or $1, -\\frac{1}{2}+\\frac{\\sqrt{3}}{2}i, -\\frac{1}{2}-\\frac{\\sqrt{3}}{2}i$",
